# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave SECRETA (service_role ou sb_secret_...). NUNCA coloque no front.
SUPABASE_SERVICE_KEY=

# Senha do painel /admin
ADMIN_PASSWORD=

# Texto longo aleatório (ex: rode: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

PORT=3000
